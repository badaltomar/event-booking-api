{
  "name": "event-booking-api",
  "version": "1.0.0",
  "description": "Backend API for an event booking system with organizer and customer roles",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "loadtest:seed": "tsx --env-file-if-exists=.env loadtest/seed.ts",
    "loadtest:sweep": "tsx --env-file-if-exists=.env loadtest/sweep.ts",
    "loadtest:updates": "tsx --env-file-if-exists=.env loadtest/updates.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "bullmq": "^6.3.16",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.2",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
