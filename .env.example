NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/booking
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

# all | api | worker
PROCESS_ROLE=all
RUN_MIGRATIONS=true
DB_POOL_MAX=20
WORKER_CONCURRENCY=10
# Requests above this many in flight get an immediate 503 instead of queueing
MAX_IN_FLIGHT=2000
AUTH_RATE_LIMIT_PER_MINUTE=20

# brevo | smtp | json
MAIL_DRIVER=json
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=Event Booking
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
